# WhatsApp de la empresa (número de WhatsApp Business, NO personal).
# Formato internacional, solo dígitos: 569XXXXXXXX
# En Vercel: Project → Settings → Environment Variables → NEXT_PUBLIC_WHATSAPP_NUMBER
# y volver a desplegar (Next.js incrusta la variable al compilar).
# Sin esta variable, los botones de WhatsApp llevan al formulario de contacto.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Luz verde del sitio. Sin esta variable el sitio queda oculto para Google
# (noindex + robots.txt bloqueado). Ponla en "true" SOLO cuando el equipo
# confirme que el sitio está listo, y vuelve a desplegar.
NEXT_PUBLIC_SITE_LIVE=
